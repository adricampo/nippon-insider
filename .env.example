# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret used to sign admin session cookies (any long random string)

# ── Admin login ───────────────────────────────────────────────────
ADMIN_PASSWORD=           # Password for the single admin account (used to access /admin) — no OAuth, no third-party accounts

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Content engine (optional) ────────────────────────────────────
OPENAI_API_KEY=           # Enables rewriteWithAI() in api/content-engine.ts; leave empty to keep using the fixed NEWS_POOL
PEXELS_API_KEY=           # Free key from pexels.com/api — used to fetch a real cover photo per post; leave empty to keep the category glyph placeholder

# ── Analytics (optional, frontend) ───────────────────────────────
VITE_GA_MEASUREMENT_ID=   # Google Analytics 4 property ID (e.g. G-XXXXXXXXXX); leave empty to skip loading GA4
